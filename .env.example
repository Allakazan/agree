# Porta da API
PORT=3000

# PostgreSQL (dados relacionais) batendo com o serviço subido no docker
DATABASE_URL=postgresql://nestuser:nestpass@localhost:5432/nestapp

# MongoDB (dados de usuários e servidores) batendo com o serviço subido no docker
MONGODB_URI=mongodb://root:1234@localhost:27017/agree?authSource=admin

# Gere um valor forte, por exemplo: openssl rand -hex 32
JWT_SECRET=troque-este-valor-por-um-segredo-forte-e-unico

# Origens liberadas no CORS (REST + WebSocket), separadas por vírgula.
# Vazio = libera qualquer origem (dev). Defina em produção.
ORIGIN=

# ── Voz (namespace /voice) ────────────────────────────────────────────────────
# Nada aqui é obrigatório: todos têm default e o módulo sobe sem nenhuma linha
# desta seção. O que muda sem elas é só o alcance do TURN (veja abaixo).

# Acima de quantos participantes a sala sai do mesh P2P e vai para o SFU. Sem o
# SFU configurado (CF_REALTIME_*), o join além desse número é recusado.
VOICE_MESH_MAX=5
# Teto de participantes numa sala já no SFU — limita o egress de uma sala só.
VOICE_SFU_MAX=25
# Teto de bitrate por stream de áudio (Opus mono). É uma política enviada ao
# cliente, não algo que o servidor consiga impor.
VOICE_MAX_AUDIO_BITRATE=40000
# Uplink total assumido por cliente. No mesh cada um codifica uma vez por peer,
# então o teto por peer divide este orçamento.
# Default: VOICE_MAX_AUDIO_BITRATE * VOICE_MESH_MAX.
VOICE_UPLINK_BUDGET=

# TURN estático (coturn, Metered, a máquina de um colega). Se TURN_URL estiver
# preenchido ele VENCE o Cloudflare — existe para testar o caminho de relay sem
# provisionar chave. Aceita lista separada por vírgula (udp, tcp, tls do mesmo host).
TURN_URL=
TURN_USER=
TURN_PASS=

# Cloudflare Realtime TURN — credenciais de vida curta, mintadas por TTL.
# Sem as duas, o servidor cai para STUN-only: funciona em dev, mas ~15-20% dos
# usuários (NAT simétrico) não conseguem conectar.
CF_TURN_KEY_ID=
CF_TURN_KEY_API_TOKEN=
# Cloudflare limita a 24h; 1h mantém curta a validade de uma credencial vazada.
CF_TURN_TTL=3600

# STUN de último recurso, quando nenhum TURN está configurado. Lista separada
# por vírgula. Default: stun:stun.cloudflare.com:3478
STUN_URL=

# Cloudflare Realtime SFU — vídeo/screenshare e salas acima de VOICE_MESH_MAX.
# As duas ou nenhuma: sem elas a voz fica só no mesh, sem vídeo. O secret nunca
# sai do servidor — toda chamada ao SFU passa pelo gateway /voice.
CF_REALTIME_APP_ID=
CF_REALTIME_APP_SECRET=
